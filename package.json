{
  "name": "voxwright",
  "version": "0.0.0",
  "private": true,
  "description": "Programmatic Minecraft build engine and Agent Skill: AI agents script builds and export .schem, .litematic, .nbt and .mcstructure, with a browser 3D preview and editor.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "typecheck": "pnpm -r --if-present run typecheck && tsc -p scripts/tsconfig.json",
    "test": "vitest run",
    "test:touch": "pnpm --filter @voxwright/web test:touch",
    "depcheck": "depcruise --config .dependency-cruiser.cjs .",
    "build:skill": "node scripts/build-skill.ts",
    "convert": "node scripts/convert.ts",
    "licenses": "node scripts/licenses.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^22.20.5",
    "dependency-cruiser": "^18.7.0",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
