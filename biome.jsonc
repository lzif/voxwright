// SPDX-License-Identifier: AGPL-3.0-only
{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!.agents",
      "!reference",
      "!**/dist",
      "!**/coverage",
      "!pnpm-lock.yaml",
      "!skills/voxwright/scripts/voxwright-cli.mjs",
      // The Markdown formatter does not know YAML frontmatter and would break the skill manifest.
      "!skills/voxwright/SKILL.md",
      // Research notes kept as they were written; formatting them would only add churn.
      "!packages/mcbuilder/docs/reels",
      "!packages/mcbuilder/docs/reel-study",
      "!LICENSE",
      "!vectors/*.json",
      "!fixtures/**/*.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
