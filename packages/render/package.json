    "./webgl": "./src/webgl/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.webgl.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@voxwright/core": "workspace:*",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.187.0",
    "pngjs": "^7.0.0"
  }
}
