{
  "name": "@voxwright/render",
  "version": "0.0.0",
  "private": true,
  "description": "Meshing and rendering for voxwright: a DOM-free section mesher and CPU rasterizer, and a three.js renderer at ./webgl. Depends on core only.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
